# ローカル開発用: このファイルをコピーして `.env.local` を作成し、実値を入れる（`.env.local` は Git に含めない）
#
# AI 記事・SNS 生成スクリプト用（Google AI Studio / Gemini API で発行）
# GEMINI_API_KEY=
# 任意: GEMINI_MODEL=gemini-2.5-flash（AI Studio の「モデルごとのレート制限」と揃える）
#
# microCMS コンテンツAPI（ブログ・導入事例の取得。Next.js の getBlogPosts 等で参照）
# 記事の API 投稿（npm run publish-post）には、同一キーで「POST」権限を有効にする
MICROCMS_SERVICE_DOMAIN=your-service-id
MICROCMS_API_KEY=your-api-key
# ブログ必須の「カテゴリ」参照用（カテゴリAPIの各行のコンテンツID）
# MICROCMS_BLOG_CATEGORY_ID=

# microCMS マネジメントAPI（scripts/setup-microcms.ts の接続確認で使用。任意）
# MICROCMS_MANAGEMENT_API_KEY=your-management-api-key
